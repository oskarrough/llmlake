#!/usr/bin/env bash
cd "$(dirname "$0")"

if [[ $# -eq 0 ]]; then
  cat <<'EOF'
Usage: ./llmlake <command>

Commands:
  collect  Copy local LLM session logs into ./data/sessions
  sync     Two-way merge ./data/sessions with a shared library folder
  build    Transform collected sessions into parquet files in ./data/parquet
  status   Instant terminal dashboard over the lake (no AI needed)
  query    Query the parquet data with duckdb

Examples:
  ./llmlake collect
  ./llmlake sync ~/Dropbox/Apps/llmlake/sessions
  ./llmlake build
  ./llmlake status --period 30d --agent claude
  ./llmlake query -c "SELECT count(*) FROM events;"
EOF
  exit 0
fi

[[ "$1" == "query" ]] && exec ./query "${@:2}"
exec bun run "$1.ts" "${@:2}"
