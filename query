#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DB="$ROOT/data/llmlake.duckdb"
PARQUET="$ROOT/data/parquet/**/*.parquet"
# `scoped` is the unfiltered twin of the view `status` builds, so queries/*.sql work here too.
INIT="CREATE OR REPLACE VIEW events AS SELECT * FROM read_parquet('$PARQUET', hive_partitioning=true, union_by_name=true); CREATE OR REPLACE VIEW scoped AS SELECT * FROM events; $(cat "$ROOT/lib/classified.sql")"

source "$ROOT/lib/freshness.sh"
warn_stale_parquet "$ROOT"

if [[ "${1:-}" == "-c" ]]; then
  shift
  duckdb "$DB" -c "$INIT $*"
elif [[ $# -gt 0 ]]; then
  duckdb "$DB" -cmd "$INIT" -cmd ".mode markdown" < "$1"
else
  duckdb "$DB" -cmd "$INIT" -cmd ".mode markdown" -cmd "SELECT column_name, column_type FROM (DESCRIBE events);" -cmd "SELECT agent, count(DISTINCT session_id) AS sessions, count(*) AS rows FROM events GROUP BY 1 ORDER BY 1;"
fi
