#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DB="$ROOT/data/llmlake.duckdb"
PARQUET="$ROOT/data/parquet/**/*.parquet"
INIT="CREATE OR REPLACE VIEW events AS SELECT * FROM read_parquet('$PARQUET', hive_partitioning=true, union_by_name=true);"

# Warn (to stderr) if collected sessions are newer than the built parquet, so a
# stale snapshot doesn't silently look like the latest data.
newest_mtime() { find "$1" -name "$2" -type f -printf '%T@\n' 2>/dev/null | awk 'NR==1||$1>m{m=$1} END{if(m)print m}'; }
src_m=$(newest_mtime "$ROOT/data/sessions" '*.jsonl')
pq_m=$(newest_mtime "$ROOT/data/parquet" '*.parquet')
if [[ -n "$src_m" ]] && { [[ -z "$pq_m" ]] || awk "BEGIN{exit !($src_m > $pq_m)}"; }; then
  echo "warning: ./data/sessions has files newer than ./data/parquet — run './llmlake build' to refresh." >&2
  echo >&2
fi

if [[ "${1:-}" == "-c" ]]; then
  shift
  duckdb "$DB" -c "$INIT $*"
elif [[ $# -gt 0 ]]; then
  duckdb "$DB" -cmd "$INIT" -cmd ".mode markdown" < "$1"
else
  duckdb "$DB" -cmd "$INIT" -cmd ".mode markdown" -cmd "SELECT column_name, column_type FROM (DESCRIBE events);" -cmd "SELECT agent, count(DISTINCT session_id) AS sessions, count(*) AS rows FROM events GROUP BY 1 ORDER BY 1;"
fi
